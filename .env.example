# MongoDB Atlas connection string (the same one the client uses)
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/studiospace?retryWrites=true&w=majority
# Name of the database that holds studios, bookings and wishlist
DB_NAME=studiospace
# Address of the Next.js client. The server downloads the JWT public keys from here
CLIENT_URL=http://localhost:3000
# Optional. Defaults to 8000
PORT=8000
