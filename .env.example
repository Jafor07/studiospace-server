
# MongoDB Atlas connection string
# Replace USER, PASSWORD, and YOUR-CLUSTER with your actual credentials.
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/studiospace?retryWrites=true&w=majority

# Optional: Database name override
# Defaults to the database specified in MONGODB_URI.
# DB_NAME=studiospace

# Next.js client URL
# The server uses this URL to download JWT public keys.
CLIENT_URL=http://localhost:3000

# Server port (default: 8000)
PORT=8000

# Better Auth secret
# Generate a secure secret for your local .env file.
BETTER_AUTH_SECRET=replace_with_a_secure_secret
